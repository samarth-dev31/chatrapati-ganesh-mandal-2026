# Copy this file to ".env" and fill in the values from your Supabase project.
# Never commit ".env". Only these public (anon/publishable) keys belong in the
# frontend — never the service-role / secret key.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable / anon key (safe for the browser; RLS enforces all permissions)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of the authorised editor account emails. The login
# screen stays password-only: the app pairs the typed password with each of
# these emails in turn (via Supabase Auth) until one signs in. This list is
# only a convenience for the password-only flow — it grants nothing on its own.
# Every write is still enforced by RLS against the public.editors table, and
# each editor must exist both as a Supabase Auth user and a public.editors row.
VITE_EDITOR_EMAILS=editor-one@example.com,editor-two@example.com,editor-three@example.com
